#!/bin/sh
# Refuses a commit that contains a Stripe secret or restricted key.
# Enabled with: git config core.hooksPath .githooks
if git diff --cached -U0 | grep -E '^\+' | grep -Eq '(sk|rk)_(live|test)_[A-Za-z0-9]{8,}|whsec_[A-Za-z0-9]{8,}'; then
  echo "pre-commit: a Stripe secret key or webhook secret is in the staged changes." >&2
  echo "Keys belong in Netlify's environment variables, never in the repository." >&2
  exit 1
fi
exit 0
